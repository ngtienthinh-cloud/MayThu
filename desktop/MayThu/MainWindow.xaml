<Window x:Class="MayThu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Máy Thu" Width="1280" Height="800" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="PlayRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <EventSetter Event="MouseLeftButtonUp" Handler="Row_Click"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightDown"/>
        </Style>
        <Style x:Key="AlarmItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
            <EventSetter Event="MouseLeftButtonUp" Handler="AlarmRow_Click"/>
        </Style>

        <DataTemplate x:Key="RowTpl">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="9" Background="{StaticResource LogoBgBrush}">
                    <Grid>
                        <TextBlock Text="{Binding Initials}" Foreground="{StaticResource LogoInkBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding LogoImage}" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Nm" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="StarBtn" Grid.Column="2" Style="{StaticResource IconBtnSm}" Tag="{Binding StarIcon}" Foreground="{StaticResource MutedBrush}"
                        ToolTip="Thêm / bỏ yêu thích" Click="RowStar_Click"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Nm" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFav}" Value="True">
                    <Setter TargetName="StarBtn" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AlarmTpl">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Tm" Text="{Binding TimeText}" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RepeatText}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="12,0,0,8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="AlarmToggle_Click" VerticalAlignment="Center" ToolTip="Bật hoặc tắt hẹn giờ này"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <Path Data="{Binding ActionIcon}" Fill="{StaticResource AmberBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActionText}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding NextText}" Foreground="{Binding NextBrush}" FontSize="12.5" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcEdit}" Foreground="{StaticResource MutedBrush}" ToolTip="Sửa" Click="AlarmEdit_Click"/>
                    <Button Style="{StaticResource IconBtnSm}" Tag="{StaticResource IcDelete}" Foreground="{StaticResource MutedBrush}" ToolTip="Xóa" Click="AlarmDelete_Click"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="Tm" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Dải báo thức đang reo ===================== -->
        <Border x:Name="RingBanner" Grid.Row="0" Visibility="Collapsed" Background="{StaticResource AmberBrush}" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RingKeepBtn" Content="Nghe tiếp" Style="{StaticResource DarkBtn}" Margin="8,0,0,0" Click="RingKeep_Click"/>
                    <Button Content="Báo lại sau 10 phút" Style="{StaticResource DarkBtn}" Margin="8,0,0,0" Click="RingSnooze_Click"/>
                    <Button Content="Tắt báo thức" Style="{StaticResource DarkBtn}" Margin="8,0,0,0" Click="RingStop_Click"/>
                </StackPanel>
                <Path Data="{StaticResource IcAlarm}" Fill="{StaticResource AmberInkBrush}" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="RingTitle" Margin="14,0,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AmberInkBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RingSub" Margin="16,0,0,0" FontSize="14" Foreground="{StaticResource AmberInkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="214"/>
                <ColumnDefinition x:Name="ListCol" Width="440" MinWidth="340"/>
                <ColumnDefinition x:Name="SplitCol" Width="6"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Thanh điều hướng ===================== -->
            <Border x:Name="Sidebar" Background="{StaticResource StageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,18,12,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                        <Control Template="{StaticResource BrandMark}" Width="40" Height="40" Focusable="False"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Máy Thu" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Truyền hình và radio" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavItem}" Tag="{StaticResource IcSettings}" Content="Cài đặt" Checked="Nav_Checked"/>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton x:Name="NavTv" GroupName="nav" Style="{StaticResource NavItem}" Tag="{StaticResource IcTv}" Content="Truyền hình" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavRadio" GroupName="nav" Style="{StaticResource NavItem}" Tag="{StaticResource IcRadio}" Content="Radio" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFav" GroupName="nav" Style="{StaticResource NavItem}" Tag="{StaticResource IcStar}" Content="Yêu thích" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMine" GroupName="nav" Style="{StaticResource NavItem}" Tag="{StaticResource IcList}" Content="Nguồn của tôi" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAlarm" GroupName="nav" Style="{StaticResource NavItem}" Tag="{StaticResource IcAlarm}" Content="Báo thức" Checked="Nav_Checked"/>
                        <Border x:Name="NextAlarmBox" Margin="2,20,2,0" Padding="14,12" CornerRadius="10" Background="{StaticResource PanelBrush}" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="NextAlarm_Click">
                            <StackPanel>
                                <TextBlock Text="Báo thức sắp tới" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="NextAlarmTime" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="NextAlarmText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== Cột trái: danh sách và các trang ===================== -->
            <Grid x:Name="LeftPane" Grid.Column="1" Margin="18,16,6,12">
                <!-- Trang danh sách kênh (TV, Radio, Yêu thích, Nguồn của tôi) -->
                <Grid x:Name="BrowsePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,6,0">
                        <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Tag="{StaticResource IcRefresh}" ToolTip="Tải lại danh sách (F5)" Click="Refresh_Click"/>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="Bold" Text="Truyền hình"/>
                            <TextBlock x:Name="PageSub" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <ComboBox x:Name="CatBox" Grid.Row="1" Margin="0,14,6,0" SelectionChanged="Cat_Changed" ToolTip="Chọn nhóm kênh"/>
                    <Grid Grid.Row="2" Margin="0,10,6,0">
                        <TextBox x:Name="SearchBox" Padding="36,0,10,0" TextChanged="Search_Changed"/>
                        <Path Data="{StaticResource IcSearch}" Fill="{StaticResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Tìm trong danh sách (Ctrl+F)" Foreground="{StaticResource MutedBrush}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <WrapPanel x:Name="ToolsRow" Grid.Row="3" Margin="0,10,0,0"/>
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <ListBox x:Name="ChannelList" ItemTemplate="{StaticResource RowTpl}" ItemContainerStyle="{StaticResource PlayRow}" KeyDown="List_KeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="RowMenu_Opened">
                                    <MenuItem x:Name="MiPlay" Header="Phát kênh này" Click="MiPlay_Click"/>
                                    <MenuItem x:Name="MiFav" Header="Thêm vào yêu thích" Click="MiFav_Click"/>
                                    <MenuItem x:Name="MiCopy" Header="Sao chép đường dẫn phát" Click="MiCopy_Click"/>
                                    <MenuItem x:Name="MiRemove" Header="Xóa khỏi danh sách này" Click="MiRemove_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <StackPanel x:Name="EmptyBox" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Visibility="Collapsed">
                            <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Button x:Name="EmptyBtn" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource AccentBtn}" Visibility="Collapsed" Click="EmptyBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Trang báo thức -->
                <Grid x:Name="AlarmPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Báo thức và hẹn giờ" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Đến giờ, Máy Thu tự bật kênh bạn chọn với âm lượng to dần, hoặc tự tắt khi bạn đi ngủ." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,16,0,8">
                        <Button Style="{StaticResource AccentBtn}" Click="AddAlarm_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcAlarm}" Fill="{StaticResource AmberInkBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm báo thức"/>
                            </StackPanel>
                        </Button>
                        <Button Click="AddStop_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcPower}" Fill="{StaticResource TextBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm hẹn giờ tắt"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <ListBox x:Name="AlarmList" Grid.Row="2" ItemTemplate="{StaticResource AlarmTpl}" ItemContainerStyle="{StaticResource AlarmItemStyle}"/>
                    <StackPanel x:Name="AlarmEmpty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                        <TextBlock Text="Chưa có báo thức nào" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Bấm Thêm báo thức để chọn giờ và kênh radio sẽ đánh thức bạn." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,12" Margin="0,10,6,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   Text="Máy Thu cần đang mở hoặc chạy ngầm ở khay đồng hồ (góc phải thanh tác vụ) thì mới báo thức được. Máy đang ngủ (Sleep) sẽ được đánh thức nếu Windows cho phép. Máy tắt hẳn thì không báo được."/>
                    </Border>
                </Grid>

                <!-- Trang cài đặt -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="Cài đặt" FontSize="24" FontWeight="Bold"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="OptStartup" Click="OptStartup_Click">
                                    <TextBlock TextWrapping="Wrap" Text="Mở Máy Thu cùng Windows (chạy ngầm ở khay đồng hồ để báo thức)"/>
                                </CheckBox>
                                <CheckBox x:Name="OptTray" Margin="0,12,0,0" Click="OptTray_Click">
                                    <TextBlock TextWrapping="Wrap" Text="Khi đóng cửa sổ mà còn báo thức đang bật thì chạy ngầm ở khay thay vì thoát hẳn"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Dữ liệu của bạn" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Mở thư mục dữ liệu" Margin="0,0,8,8" Click="OpenData_Click"/>
                                    <Button Content="Xóa danh sách kênh đã lưu" Margin="0,0,8,8" Click="ClearCache_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Xem kênh có bản quyền" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="VTV, HTV và nhiều kênh khác phát chính thức trên các nền tảng sau. Bấm để mở bằng trình duyệt." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="13"/>
                                <StackPanel x:Name="OfficialPanel"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Phím tắt" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <Grid x:Name="KeysGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AboutTitle" Text="Máy Thu cho Windows" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"
                                           Text="Kênh truyền hình lấy từ danh mục công khai iptv-org, đài radio lấy từ danh bạ Radio Browser. App không lưu trữ nội dung, chỉ mở các luồng phát công khai. Kênh do cộng đồng tổng hợp nên có kênh ngừng phát hoặc bị chặn vùng; gặp kênh như vậy hãy chuyển sang kênh khác."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Thông báo nhanh -->
                <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,6,8" Padding="16,10" CornerRadius="10"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="400">
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <GridSplitter x:Name="Splitter" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

            <!-- ===================== Màn hình phát ===================== -->
            <Grid x:Name="Stage" Grid.Column="3" Background="{StaticResource StageBrush}">
                <vlc:VideoView x:Name="Video" Background="Black" Visibility="Hidden">
                    <Grid x:Name="VideoOverlay" Background="#01000000" Visibility="Collapsed" MouseLeftButtonDown="Video_MouseDown">
                        <Border x:Name="FsHint" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" Background="#DD0E1820" CornerRadius="10" Padding="16,8" Visibility="Collapsed">
                            <TextBlock Text="Nhấn Esc hoặc nhấp đúp để thoát toàn màn hình" Foreground="#E8EEF1" FontSize="14"/>
                        </Border>
                    </Grid>
                </vlc:VideoView>
                <Grid x:Name="CardRoot" Background="{StaticResource StageBrush}" MouseLeftButtonDown="Card_MouseDown">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="32">
                        <Control x:Name="CardBrand" Template="{StaticResource BrandMark}" Width="128" Height="128" Focusable="False"/>
                        <Border x:Name="CardLogoBox" Width="176" Height="176" CornerRadius="26" Background="{StaticResource LogoBgBrush}" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="CardInitials" FontSize="56" FontWeight="Bold" Foreground="{StaticResource LogoInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="CardLogo" Margin="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CardName" FontSize="28" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0" Text="Chọn một kênh để bắt đầu"/>
                        <TextBlock x:Name="CardSong" FontSize="17" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CardStatus" FontSize="14" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Bấm vào một kênh truyền hình hoặc đài radio ở danh sách bên trái."/>
                        <StackPanel x:Name="CardActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
                            <Button Content="Thử lại" Click="Retry_Click"/>
                            <Button Content="Kênh tiếp theo" Style="{StaticResource AccentBtn}" Margin="10,0,0,0" Click="Next_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="CardHelp" FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,26,0,0"
                                   Text="Phím tắt: Space phát hoặc dừng, N và B chuyển kênh, + và - chỉnh âm lượng, F toàn màn hình."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Thanh phát ===================== -->
        <Border x:Name="PlayerBar" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource LogoBgBrush}">
                        <Grid>
                            <TextBlock x:Name="BarInitials" FontSize="17" FontWeight="Bold" Foreground="{StaticResource LogoInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="BarLogo" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BarName" Text="Chưa phát kênh nào" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarStatus" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcPrev}" ToolTip="Kênh trước (B)" Click="Prev_Click"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Tag="{StaticResource IcPlay}" ToolTip="Phát hoặc dừng (Space)" Margin="6,0" Click="Play_Click"/>
                    <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcNext}" ToolTip="Kênh sau (N)" Click="Next_Click"/>
                </StackPanel>
                <Grid x:Name="Dial" Grid.Column="2" Margin="20,0" Height="34" VerticalAlignment="Center" ToolTip="Vị trí kênh đang phát trong danh sách" SizeChanged="Dial_SizeChanged">
                    <Border Height="2" Background="{StaticResource LineBrush}" VerticalAlignment="Center"/>
                    <Rectangle Height="16" VerticalAlignment="Center" Fill="{StaticResource DialTicks}"/>
                    <Canvas x:Name="DialCanvas" ClipToBounds="False">
                        <Border x:Name="Needle" Width="3" Height="30" Canvas.Top="2" CornerRadius="1.5" Background="{StaticResource RedBrush}" Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SleepBtn" Style="{StaticResource IconBtn}" Tag="{StaticResource IcTimer}" ToolTip="Hẹn giờ tắt: bấm để chọn 15, 30, 60 hoặc 90 phút" Click="Sleep_Click"/>
                    <TextBlock x:Name="SleepText" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Button x:Name="FavBtn" Style="{StaticResource IconBtn}" Tag="{StaticResource IcStarBorder}" ToolTip="Thêm vào yêu thích" Click="FavBtn_Click"/>
                    <Button x:Name="MuteBtn" Style="{StaticResource IconBtn}" Tag="{StaticResource IcVolume}" ToolTip="Tắt tiếng (M)" Click="Mute_Click"/>
                    <Slider x:Name="VolSlider" Width="110" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="Vol_Changed"/>
                    <TextBlock x:Name="VolText" Width="40" Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button x:Name="FsBtn" Style="{StaticResource IconBtn}" Tag="{StaticResource IcFullscreen}" ToolTip="Toàn màn hình (F)" Click="Fs_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
